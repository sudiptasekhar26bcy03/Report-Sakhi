      "normal": { "min": 27.0, "max": 32.0 },
      "critical_low": 18.0,
      "critical_high": 42.0,
      "description": {
        "en": "Average amount of hemoglobin inside each red blood cell",
        "hi": "प्रत्येक लाल रक्त कोशिका में मौजूद हीमोग्लोबिन की मात्रा",
        "ml": "ഓരോ രക്താണുവിനുള്ളിലെയും ശരാശരി ഹീമോഗ്ലോബിൻ",
        "ta": "ஒவ்வொரு சிவப்பு அணுவிலும் உள்ள ஹீமோகுளோபின் அளவு"
      }
    },
    "mchc": {
      "canonical_name": "Mean Cell Hemoglobin Concentration (MCHC)",
      "aliases": ["mean cell haemoglobin con mchc", "mean cell hemoglobin con mchc", "mean cell haemoglobin con", "mean cell hemoglobin con", "mean cell haemoglobin concentration", "mean cell hemoglobin concentration", "mchc"],
      "unit": "%",
      "normal": { "min": 31.5, "max": 34.5 },
      "critical_low": 26.0,
      "critical_high": 38.0,
      "description": {
        "en": "Average concentration of hemoglobin in a given volume of red cells",
        "hi": "लाल रक्त कोशिकाओं में हीमोग्लोबिन की सांद्रता",
        "ml": "ചുവന്ന രക്താണുക്കളിലെ ഹീമോഗ്ലോബിന്റെ സാന്ദ്രത",
        "ta": "சிவப்பு அணுக்களில் உள்ள ஹீமோகுளோபின் அடர்த்தி"
      }
    },
    "neutrophils": {
      "canonical_name": "Neutrophils",
      "aliases": ["neutrophils", "neutrophil", "segs", "polymorphs", "neutrophil count"],
      "unit": "%",
      "normal": { "min": 40.0, "max": 80.0 },
      "critical_low": 20.0,
      "critical_high": 90.0,
      "description": {
        "en": "Primary white blood cells that fight bacterial infections",
        "hi": "बैक्टीरिया संक्रमण से लड़ने वाली मुख्य श्वेत कोशिकाएं",
        "ml": "ബാക്ടീരിയൽ അണുബാധകളെ ചെറുക്കുന്ന പ്രധാന കോശങ്ങൾ",
        "ta": "பாக்டீரியா தொற்றை எதிர்க்கும் முக்கிய அணுக்கள்"
      }
    },
    "lymphocytes": {
      "canonical_name": "Lymphocytes",
      "aliases": ["lymphocyte", "lymphocytes", "lymphs", "lymphocyte count"],
      "unit": "%",
      "normal": { "min": 20.0, "max": 40.0 },
      "critical_low": 10.0,
      "critical_high": 65.0,
      "description": {
        "en": "White blood cells that fight viruses and build immunity",
        "hi": "वायरस से लड़ने और प्रतिरक्षा प्रणाली बनाने वाली कोशिकाएं",
        "ml": "വൈറസുകൾക്കെതിരെ പ്രതിരോധം തീർക്കുന്ന കോശങ്ങൾ",
        "ta": "வைரஸ்களை எதிர்க்கும் நோய் எதிர்ப்பு அணுக்கள்"
      }
    },
    "monocytes": {
      "canonical_name": "Monocytes",
      "aliases": ["monocyte", "monocytes", "monos", "monocyte count"],
      "unit": "%",
      "normal": { "min": 2.0, "max": 10.0 },
      "critical_low": 0.0,
      "critical_high": 20.0,
      "description": {
        "en": "Scavenger white blood cells that clean up damaged tissues",
        "hi": "संक्रमण और मृत कोशिकाओं को साफ करने वाली कोशिकाएं",
        "ml": "അണുബാധകളെയും കേടായ കോശങ്ങളെയും നീക്കം ചെയ്യുന്ന കോശങ്ങൾ",
        "ta": "கிருமிகளை அழித்து தூய்மைப்படுத்தும் இரத்த அணுக்கள்"
      }
    },
    "eosinophils": {
      "canonical_name": "Eosinophils",
      "aliases": ["eosinophils", "eosinophil", "eos", "eosinophil count"],
      "unit": "%",
      "normal": { "min": 1.0, "max": 6.0 },
      "critical_low": 0.0,
      "critical_high": 15.0,
      "description": {
        "en": "White blood cells involved in allergies and parasite defense",
        "hi": "एलर्जी और संक्रमण से जुड़ी श्वेत कोशिकाएं",
        "ml": "അലർജിയും അണുബാധകളും ചെറുക്കുന്ന രക്താണുക്കൾ",
        "ta": "ஒவ்வாமை மற்றும் ஒட்டுண்ணிகளை எதிர்க்கும் அணுக்கள்"
      }
    },
    "basophils": {
      "canonical_name": "Basophils",
      "aliases": ["basophils", "basophil", "basos", "basophil count"],
      "unit": "%",
      "normal": { "min": 0.0, "max": 2.0 },
      "critical_low": 0.0,
      "critical_high": 5.0,
      "description": {
        "en": "White blood cells that release histamine during allergic responses",
        "hi": "एलर्जी प्रतिक्रिया के समय सक्रिय होने वाली कोशिकाएं",
        "ml": "അലർജി ഉണ്ടാകുമ്പോൾ പ്രതികരിക്കുന്ന രക്താണുക്കൾ",
        "ta": "ஒவ்வாமை எதிர்வினைகளில் செயல்படும் இரத்த அணுக்கள்"
      }
    }
  }
